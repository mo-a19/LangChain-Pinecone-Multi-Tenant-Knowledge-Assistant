# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=1000

# Smart model routing (short/simple questions -> cheaper model)
ENABLE_SMART_ROUTING=True
SIMPLE_QUERY_MODEL=gpt-4o-mini
COMPLEX_QUERY_MODEL=gpt-4

# --- Pinecone (index is created automatically if missing) ---
PINECONE_API_KEY=
PINECONE_INDEX=knowledge-hub
PINECONE_ENVIRONMENT=us-east-1
PINECONE_HOST=
PINECONE_DIMENSION=1024
PINECONE_METRIC=cosine

# --- MongoDB ---
MONGODB_URI=mongodb://localhost:27017/knowledge_hub

# --- Auth ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
